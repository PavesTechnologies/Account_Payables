# Backend/.env.example
# Copy to Backend/.env and fill in real values. Never commit the real .env file.

# ---------------------------------------------------------
# Database (PostgreSQL) — required
# ---------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>

# ---------------------------------------------------------
# Frontend (used for CORS allow-origin) — required
# ---------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------
# Server bind settings — optional, only read by the commented-out
# `if __name__ == "__main__"` block in main.py (not used when the app
# is started via `uvicorn Backend.main:app`)
# ---------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# ---------------------------------------------------------
# UMS (identity provider) — required
# Used for JWT validation via OpenID Connect Discovery + JWKS.
# ---------------------------------------------------------
UMS_URL=https://<ums-host>

# ---------------------------------------------------------
# Sandbox API (GSTIN validation / GSTN lookups) — required for
# vendor GSTIN verification and auto-onboarding
# ---------------------------------------------------------
SANDBOX_BASE_URL=https://test-api.sandbox.co.in
SANDBOX_API_KEY=<sandbox-api-key>
SANDBOX_API_SECRET=<sandbox-api-secret>

# ---------------------------------------------------------
# Mailbox credentials (Microsoft Graph — reading inbound invoice emails)
# required by /apm/intake/* endpoints
# ---------------------------------------------------------
CLIENT_ID=<azure-app-client-id>
CLIENT_SECRET=<azure-app-client-secret>
TENANT_ID=<azure-tenant-id>
MAIL_ADDRESS=<mailbox-address>

# ---------------------------------------------------------
# AWS S3 (invoice document storage) — required for
# /apm/invoice/process-invoice and /apm/invoice-details/invoice/view/*
# ---------------------------------------------------------
AWS_ACCESS_KEY_ID=<aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>
AWS_REGION=<aws-region>
AWS_BUCKET_NAME=<aws-bucket-name>

# ---------------------------------------------------------
# SMTP (outbound notification emails, e.g. vendor-not-found alerts)
# required by /apm/intake/send-mail and Business_Layer/utils/notifications.py
# ---------------------------------------------------------
EMAIL_USER=<smtp-username>
EMAIL_PASSWORD=<smtp-password>
EMAIL_HOST=<smtp-host>
EMAIL_PORT=587
